# ===== PicMyEvent · variables de entorno (copiar a .env.local) =====

# --- Supabase (proyecto creado en supabase.com) ---
# En el dashboard de Supabase, ademas:
#  · Auth > Providers > Google: habilitado, con GOOGLE_CLIENT_ID/SECRET de la
#    consola de Google Cloud y URL de redireccion https://TU-DOMINIO/api/auth/callback
#  · Auth > URL Configuration > Redirect URLs: anadir https://TU-DOMINIO/api/auth/callback
#  · Storage: bucket publico "thumbs" (cache publico, 1 ano) para los thumbnails
#  · Realtime: habilitar postgres_changes para photos, likes y comments
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU-ANON-KEY
SUPABASE_SERVICE_ROLE_KEY=TU-SERVICE-ROLE-KEY   # NUNCA exponer en el cliente

# --- Google OAuth (consola de Google Cloud, app PUBLICADA) ---
# Scopes: profile, email, https://www.googleapis.com/auth/drive.file
# El login del organizador (Supabase Auth) pide SOLO profile+email
# (identidad, P9). El alcance drive.file vive EXCLUSIVAMENTE en el
# flujo OAuth propio PKCE de F3 (/api/drive/connect) que usa
# GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET y cifra el refresh token.
GOOGLE_CLIENT_ID=TU-CLIENT-ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=TU-CLIENT-SECRET
GOOGLE_REDIRECT_URI=https://TU-DOMINIO/api/drive/callback

# --- Cifrado de tokens (clave aleatoria de 32+ bytes, base64) ---
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=CLAVE-BASE64-32-BYTES

# --- App ---
NEXT_PUBLIC_APP_URL=https://TU-DOMINIO.vercel.app
